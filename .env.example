# ==============================================================================
# PulseCRM — Environment Configuration Template
# Safe template for local setup and production deployment.
# Copy this file to .env.local for local development.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Database Connection (PostgreSQL 15+ / Supabase Transaction Pooler / Direct URL)
# For local Supabase CLI: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# For production: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Authentication & Demo Mode Controls
# In development: DEMO_MODE=true permits persona switching without Supabase credentials.
# In production: DEMO_MODE must be set to "false" (or omitted). Production requires a valid
# authenticated Supabase session.
DEMO_MODE=true
NODE_ENV=development

# Supabase Auth & Storage (Required for Production Authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# AI Sales Copilot (Google Generative AI / Gemini)
# If omitted or unavailable, PulseCRM automatically degrades to deterministic heuristic analysis.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-placeholder
AI_MODEL=gemini-1.5-flash

# Webhook Security Configuration
# Tolerance in seconds against replay attacks (default: 300s = 5 minutes)
WEBHOOK_HMAC_TOLERANCE_SECONDS=300

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Distributed Rate Limiting (Optional)
# In-memory sliding window counter is used if unconfigured.
# For distributed multi-region serverless deployments, provide an Upstash or Redis connection URL.
RATE_LIMIT_REDIS_URL=
